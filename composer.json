{
    "name": "enetpartner/vslinkcomposer",
    "version": "5.4.1",
    "description": "Composer avec les services vslink",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "symfony/security-bundle": "5.4.*",
        "symfony/console": "5.4.*",
        "symfony/dependency-injection": "5.4.*",
        "symfony/config": "5.4.*",
        "doctrine/annotations": "^1.14",
        "doctrine/doctrine-bundle": "^2.7",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.10",
        "stof/doctrine-extensions-bundle": "*",
        "symfony/process": "5.4.*"
    },
    "license": "MIT",   
    "autoload": {
        "psr-4": {
            "Enetpartner\\Vslinkcomposer\\": "src/"
        },
        "files": [
            "src/RandomPassword/Password.php"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.*"
        }
       
    },
    "authors": [
        {
            "name": "TomBuathierVscloud",
            "email": "tom.buathier@enetpartner.fr"
        }
    ],
    "minimum-stability": "dev"
}
