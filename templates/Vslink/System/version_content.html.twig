<div class="m-2">
    <style>
        th, td {
            padding: 8px;
            text-align: left;
        }

        th:first-child, td:first-child {
            width: 30%; /* La colonne "Commande" occupe la moitié de la largeur */
            word-wrap: break-word;
        }

        th:not(:first-child), td:not(:first-child) {
            width: 10%; /* Les autres colonnes prennent moins d'espace */
            text-align: center;
        }
    </style>
	<h4 class="mb-4">Liste des versions</h4>
	{% if versions is not empty %}
		<div class="table-responsive" style="max-height: 400px; overflow-y: auto;" >
			<table class="table table-striped table-hover table-white" style="font-size: 1rem;" width="90%">
				<thead class="bg-white text-primary">
					<tr style="display: table; width: 100%; table-layout: fixed;">
                        <th scope="col">Version</th>
						<th scope="col">Date</th>
					</tr>
				</thead>
				<tbody class=" text-primary" style="display: block; max-height: 300px; overflow-y: auto;">
					{% for version in versions %}
						<tr style="display: table; width: 100%; table-layout: fixed;">
                            <td>{{ version.getRelease }}</td>
							<td>{{ version.createdAt | date('d.m.Y H:i') }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% else %}
		<p>Aucune version trouvée.</p>
	{% endif %}
</div>
