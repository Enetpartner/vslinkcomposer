<div class="m-2">
    <style>
        th, td {
            padding: 8px;
            text-align: left;
        }

        th:first-child, td:first-child {
            width: 30%; /* La colonne "Commande" occupe la moitié de la largeur */
            word-wrap: break-word;
        }

        th:not(:first-child), td:not(:first-child) {
            width: 10%; /* Les autres colonnes prennent moins d'espace */
            text-align: center;
        }
    </style>
	<h4 class="mb-4">Liste des crontab www-data</h4>
	{% if cronJobs is not empty %}
		<div class="table-responsive" style="max-height: 400px; overflow-y: auto;" >
			<table class="table table-striped table-hover table-white" style="font-size: 1rem;" width="90%">
				<thead class="bg-white text-primary">
					<tr style="display: table; width: 100%; table-layout: fixed;">
                        <th scope="col">Commande</th>
						<th scope="col">Minute</th>
						<th scope="col">Heure</th>
						<th scope="col">Jour du mois</th>
                        <th scope="col">mois</th>
						<th scope="col">Jour de semaine</th>
					</tr>
				</thead>
				<tbody class=" text-primary" style="display: block; max-height: 300px; overflow-y: auto;">
					{% for job in cronJobs %}
						<tr style="display: table; width: 100%; table-layout: fixed;">
                            <td>{{ job[5] }}</td>
							<td>{{ job[0] }}</td>
							<td>{{ job[1] }}</td>
							<td>{{ job[2] }}</td>
							<td>{{ job[3] }}</td>
							<td>{{ job[4] }}</td>
						</tr>
					{% else %}
						<tr style="display: table; width: 100%; table-layout: fixed;">
							<td colspan="3" class="text-center">Aucun fichier trouvé.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% else %}
		<p>Aucune tâche Cron trouvée.</p>
	{% endif %}
</div>
