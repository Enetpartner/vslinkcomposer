<div class="m-2">
    <style>
        th, td {
            padding: 8px;
            text-align: left;
        }

        th:first-child, td:first-child {
            width: 30%; /* La colonne "Commande" occupe la moitié de la largeur */
            word-wrap: break-word;
        }

        th:not(:first-child), td:not(:first-child) {
            width: 10%; /* Les autres colonnes prennent moins d'espace */
            text-align: center;
        }
    </style>
    <h4 class="mb-4">Liste des fichiers du dossier backup</h4>
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table id="resTable" class="table table-striped table-hover table-white" style="font-size: 1rem;">
            <thead class="bg-white text-primary">
                <tr style="display: table; width: 100%; table-layout: fixed;">
                    <th scope="col" onclick="sortTable(0)" style="cursor:pointer;">Nom du fichier</th>
                    <th scope="col" onclick="sortTable(1)" style="cursor:pointer;">Taille (KB)</th>
                    <th scope="col" onclick="sortTable(2)" style="cursor:pointer;">Date de modification</th>
                </tr>
            </thead>
            <tbody class=" text-primary" style="display: block; max-height: 300px; overflow-y: auto;">
                {% for file in files %}
                    <tr style="display: table; width: 100%; table-layout: fixed;">
                        <td>{{ file.name }}</td>
                        <td>{{ (file.size / 1024)|number_format(2) }}</td>
                        <td>{{ file.formatted_date }}</td>
                    </tr>
                {% else %}
                    <tr style="display: table; width: 100%; table-layout: fixed;">
                        <td colspan="3" class="text-center">Aucun fichier trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<script>
        // Fonction pour trier le tableau
        function sortTable(columnIndex) {
            var table = document.getElementById("resTable");
            var rows = Array.from(table.rows).slice(1); // Ignorer la première ligne (en-tête)
            var isAscending = table.getAttribute('data-sort-direction') === 'asc';

            rows.sort(function(rowA, rowB) {
                var cellA = rowA.cells[columnIndex].innerText.trim();
                var cellB = rowB.cells[columnIndex].innerText.trim();

                if (columnIndex === 1) { // Taille : comparer les valeurs numériques
                    cellA = parseFloat(cellA);
                    cellB = parseFloat(cellB);
                } 
                if (columnIndex === 2) { // Date : comparer les dates
                    cellA = new Date(cellA);
                    cellB = new Date(cellB);
                }

                if (isAscending) {
                    return cellA > cellB ? 1 : (cellA < cellB ? -1 : 0);
                } else {
                    return cellA < cellB ? 1 : (cellA > cellB ? -1 : 0);
                }
            });

            // Réafficher les lignes triées
            rows.forEach(function(row) {
                table.appendChild(row);
            });

            // Inverser la direction du tri
            table.setAttribute('data-sort-direction', isAscending ? 'desc' : 'asc');
        }
</script>