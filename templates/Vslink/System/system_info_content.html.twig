<div class="m-2">
    <style>
        th, td {
            padding: 8px;
            text-align: left;
        }

        th:first-child, td:first-child {
            width: 30%; /* La colonne "Commande" occupe la moitié de la largeur */
            word-wrap: break-word;
        }

        th:not(:first-child), td:not(:first-child) {
            width: 10%; /* Les autres colonnes prennent moins d'espace */
            text-align: center;
        }
    </style>
	<h4 class="mb-4">System info</h4>
		<div class="table-responsive"  >
			<table class="table table-striped table-hover table-white" style="font-size: 1rem;" width="90%">
				<tr>
					<th colspan="2">Version de l'OS</th>
				</tr>
				<tr>
					<td>Version</td>
					<td>{{ os_version }}</td>
				</tr>
				<tr>
					<td>Dernière mise à jour sécurité</td>
					<td>{{ last_update }}</td>
				</tr>
				<tr>
					<td>Banissement IP</td>
					<td>{{ fail2ban }}</td>
				</tr>
				<tr>
					<th colspan="2">Utilisation du Disque</th>
				</tr>
				<tr>
					<td>Total</td>
					<td>{{ disk_usage.total }}</td>
				</tr>
				<tr>
					<td>Libre</td>
					<td>{{ disk_usage.free }}</td>
				</tr>
				<tr>
					<td>Utilisé</td>
					<td>{{ disk_usage.used }}</td>
				</tr>
				
				<tr>
					<th colspan="2">Utilisation de la Mémoire</th>
				</tr>
				<tr>
					<td>Total</td>
					<td>{{ memory_usage.total }}</td>
				</tr>
				<tr>
					<td>Libre</td>
					<td>{{ memory_usage.free }}</td>
				</tr>
				<tr>
					<td>Utilisée</td>
					<td>{{ memory_usage.used }}</td>
				</tr>
			</table>
		</div>
</div>